  "info": {
    "_postman_id": "159f84ba-cdf5-4948-86e8-dd9b9be8b5cf",
    "name": "Zylo Enterprise Applications Subscriptions API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Zylo Enterprise API provides a modern, RESTful API to work with your SaaS subscription data. The API is built using resource-oriented URLs that are protected by HTTPS transport security and authenticated via secure tokens. It enables the export of SaaS usage and subscription data to reporting tools outside of Zylo, as well as the import of additional unintegrated usage data.\n\nContact Support:\n Name: Zylo",
      "type": "text/plain"
    }
  }
