      "id": "f0813c40-3053-4695-b304-d8b961679f47",
      "name": "Subscriptions",
      "description": {
        "content": "Subscriptions are configured instances created in the Zylo user interface. They typically have a 1:1 relationship to a given application, though you may also have multiple subscriptions to the same application within your organization.",
        "type": "text/plain"
      },
